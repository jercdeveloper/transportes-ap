# Copia este archivo a .env.local y completa los valores de tu proyecto Supabase
# (Supabase Dashboard -> Project Settings -> API).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. NUNCA exponer al navegador ni con prefijo NEXT_PUBLIC_.
# Se usa para crear cuentas de chofer/padre desde el panel de admin.
# Project Settings -> API -> "Secret keys".
SUPABASE_SERVICE_ROLE_KEY=

# Notificaciones push (Web Push). Genera un par único por proyecto con:
#   npx web-push generate-vapid-keys
VAPID_SUBJECT=mailto:tu-correo@ejemplo.com
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Opcional: protege /api/cron/payment-reminders para que solo tu programador
# de tareas (ej. Vercel Cron) pueda llamarlo. Sin esto, el endpoint es público.
CRON_SECRET=

# Búsqueda/autocompletado de direcciones y ETA por carretera del mapa en
# vivo (Google Geocoding + Places API (New) + Routes API). Server-only,
# nunca con prefijo NEXT_PUBLIC_ — la usan /api/geocode, /api/places-
# autocomplete, /api/place-details y /api/route-eta desde el servidor, la
# clave nunca llega al navegador.
#
# 1. https://console.cloud.google.com/ -> crea un proyecto (o usa uno
#    existente) -> activa facturación (pide tarjeta, pero el uso de esta
#    app se queda dentro de los $200 USD/mes gratis de Google Maps
#    Platform).
# 2. APIs & Services -> Library -> activa (Enable) estas tres, una por una:
#    "Geocoding API", "Places API (New)", "Routes API".
# 3. APIs & Services -> Credentials -> Create credentials -> API key.
# 4. Click en la key recién creada -> "API restrictions" -> restringe a
#    esas tres APIs únicamente (así aunque se filtrara no sirve para nada
#    más caro, como el Maps JavaScript API).
GOOGLE_MAPS_API_KEY=
